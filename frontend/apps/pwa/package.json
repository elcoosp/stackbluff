{
  "name": "@stackbluff/pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm gen:routes && vite --port 5173",
    "gen:routes": "tsr generate",
    "build": "pnpm gen:routes && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest --config e2e/vitest.config.e2e.ts",
    "test:e2e:ui": "vitest --config e2e/vitest.config.e2e.ts --ui",
    "test:e2e:watch": "vitest --config e2e/vitest.config.e2e.ts --watch",
    "test:e2e:headless": "HEADLESS=true vitest --config e2e/vitest.config.e2e.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.17",
    "@sentry/browser": "^10.65.0",
    "@sentry/react": "^10.65.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@stackbluff/shared": "workspace:*",
    "@stripe/stripe-js": "^9.9.0",
    "@tanstack/react-virtual": "^3.14.3",
    "class-variance-authority": "^0.7.1",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-timeago-i18n": "^2.4.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
