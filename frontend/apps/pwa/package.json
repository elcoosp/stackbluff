  "devDependencies": {
    "@tanstack/router-cli": "1.167.17",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/axios": "^0.14.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.9",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "jsdom": "^26.0.0",
    "puppeteer": "^25.2.1",
    "puppeteer-cluster": "^0.25.0",
