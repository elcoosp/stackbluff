{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@stackbluff/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@stackbluff/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "e2e",
    "src",
    "../../packages/shared/src"
  ],
  "exclude": [
    "e2e",
    "src/__tests__",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}