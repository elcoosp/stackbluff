# @stackbluff/mobile — EXPO_PUBLIC_* environment variables (Agent-06 / Task 2-c)
#
# Expo inlines every variable prefixed with EXPO_PUBLIC_ into the JS bundle
# at build time. Copy this file to `.env` (never commit `.env`).
# Values marked (placeholder) are intentionally fake — the app degrades
# gracefully and logs a dev banner until real values are provided.

# ── Backend API ────────────────────────────────────────────────────────────
# Base URL of the StackBluff Rust backend (sb-server).
# Falls back to app.json `expo.extra.apiBaseUrl` when unset.
EXPO_PUBLIC_API_URL=https://stackbluff.com

# ── RevenueCat (mobile IAP) ────────────────────────────────────────────────
# Public "app-specific" API keys from https://app.revenuecat.com → Project → API keys.
# iOS keys start with `appl_`, Android keys with `goog_`.
# Falls back to app.json `expo.extra.revenuecat.{ios,android}` when unset.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_revenuecat_ios_key_placeholder
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_revenuecat_android_key_placeholder

# NOTE (server side): the verify/webhook endpoints in sb-payment also read
# REVENUECAT_SECRET_API_KEY and REVENUECAT_WEBHOOK_SECRET from the backend
# environment — those are NOT bundled into the app and are documented in the
# backend env config.

# ── Sentry (crash reporting) ───────────────────────────────────────────────
# Sentry init is a no-op while this stays unset.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Set to "true" to enable Sentry debug logging in development builds.
EXPO_PUBLIC_SENTRY_DEBUG=false

# ── EAS project id ─────────────────────────────────────────────────────────
# Not an EXPO_PUBLIC_ var — lives in app.json under `expo.extra.eas.projectId`
# (currently the placeholder 00000000-0000-0000-0000-000000000000, owned by
# the integrator/release lane). Used by expo-notifications for push tokens.
