{
  "$schema": "https://expo.dev/eas/schema.json",
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://localhost:8080",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8080/ws",
        "EXPO_PUBLIC_SENTRY_DSN": "",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "REPLACE_ME_RC_IOS_PUBLIC_SDK_KEY",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "REPLACE_ME_RC_ANDROID_PUBLIC_SDK_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://api.stackbluff.example",
        "EXPO_PUBLIC_WS_URL": "wss://api.stackbluff.example/ws",
        "EXPO_PUBLIC_SENTRY_DSN": "REPLACE_ME_SENTRY_DSN",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "REPLACE_ME_RC_IOS_PUBLIC_SDK_KEY",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "REPLACE_ME_RC_ANDROID_PUBLIC_SDK_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.stackbluff.example",
        "EXPO_PUBLIC_WS_URL": "wss://api.stackbluff.example/ws",
        "EXPO_PUBLIC_SENTRY_DSN": "REPLACE_ME_SENTRY_DSN",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "REPLACE_ME_RC_IOS_PUBLIC_SDK_KEY",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "REPLACE_ME_RC_ANDROID_PUBLIC_SDK_KEY"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "REPLACE_ME_APPLE_ID_EMAIL",
        "ascAppId": "REPLACE_ME_ASC_APP_ID",
        "appleTeamId": "REPLACE_ME_APPLE_TEAM_ID"
      }
    }
  }
}
