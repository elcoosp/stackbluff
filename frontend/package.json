{
  "name": "stackbluff-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:pwa": "pnpm --filter @stackbluff/pwa dev",
    "dev:mini": "pnpm --filter @stackbluff/mini-app dev",
    "dev": "pnpm run dev:pwa & pnpm run dev:mini",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.9.3"
  },
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "framer-motion": "^12.40.0",
    "zustand": "^5.0.11"
  }
}
