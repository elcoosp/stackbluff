{
  "manifest_version": 3,
  "name": "SBDC Generator",
  "version": "2.0",
  "permissions": ["storage", "tabs", "scripting", "webNavigation"],
  "host_permissions": ["http://localhost:*/*", "https://perchance.org/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html"
  }
}
