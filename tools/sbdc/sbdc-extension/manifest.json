{
  "manifest_version": 3,
  "name": "SBDC Generator",
  "version": "1.0",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["http://localhost:*/*", "https://perchance.org/*"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://perchance.org/fluxgen*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup.html"
  }
}
