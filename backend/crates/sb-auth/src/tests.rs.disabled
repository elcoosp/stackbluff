        async fn update_chip_balance_with_conn(
            &self,
            _conn: &sea_orm::DatabaseConnection,
            _ctx: RequestContext,
            _user_id: UserId,
            _delta: i64,
        ) -> PersistenceResult<i64> {
            unimplemented!()
